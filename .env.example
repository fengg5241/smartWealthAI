# =========================================
# SmartRAG — Environment Variables
# =========================================
# Copy this to .env and fill in your values

# --- AI Provider (pick one) ---
SPRING_PROFILES_ACTIVE=bailian
DASHSCOPE_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx  (only if using SPRING_PROFILES_ACTIVE=gpt)

# --- Database ---
DB_NAME=smart_wealth_ai
DB_USER=postgres
DB_PASSWORD=change-me

# --- Admin Access ---
DEMO_ADMIN_KEY=change-me-to-a-strong-secret

# --- OSS (Alibaba Cloud, for product images) ---
OSS_ENDPOINT=oss-ap-southeast-1-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=LTAI5txxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxx
OSS_BUCKET=smartwealth-product-images

# =========================================
# IM Bot (optional — only set if you want this feature)
# =========================================

# --- Slack Bot ---
# Setup: api.slack.com → Create App → OAuth + Slash Commands + Events
# SLACK_ENABLED=true
# SLACK_CLIENT_ID=1234567890.1234567890
# SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxx

# --- WeChat Work Bot ---
# Setup: work.weixin.qq.com → App Management → Create Self-built App
# WECOM_ENABLED=true
# WECOM_CORP_ID=ww1234567890abcdef
# WECOM_TOKEN=xxxxxxxxxxxxxxxxxx
# WECOM_ENCODING_AES_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WECOM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================
# Document Sync (optional — only set if you want this feature)
# =========================================

# --- Google Drive Sync ---
# Setup: console.cloud.google.com → APIs & Services → OAuth consent + Credentials
# GOOGLEDRIVE_ENABLED=true
# GOOGLEDRIVE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
# GOOGLEDRIVE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLEDRIVE_REDIRECT_URI=https://your-domain.com/api/sync/google-drive/callback

# --- OneDrive Sync ---
# Setup: portal.azure.com → App registrations → New registration
# ONEDRIVE_ENABLED=true
# ONEDRIVE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ONEDRIVE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# ONEDRIVE_REDIRECT_URI=https://your-domain.com/api/sync/onedrive/callback
# ONEDRIVE_TENANT_ID=common

# --- Gmail setting ---
#MAIL_USERNAME=xxx@gmail.com
#MAIL_PASSWORD=xxx

# --- Stripe Payment ---
#STRIPE_SECRET_KEY=sk_live_xxx
#STRIPE_WEBHOOK_SECRET=whsec_xxx
#APP_DOMAIN=https://your-domain.com

# Monthly plan
#STRIPE_PRICE_MONTHLY_ID=price_xxx
#PRICING_MONTHLY_AMOUNT=5.90

# Annual plan
#STRIPE_PRICE_ANNUAL_ID=price_yyy
#PRICING_ANNUAL_AMOUNT=59.00

#PRICING_CURRENCY=SGD
